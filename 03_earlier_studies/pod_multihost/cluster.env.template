# =====================================================================
# cluster.env — Blind at Scale MULTI-HOST cluster configuration.
# Copy to cluster.env and fill at deploy time. THE SAME FILE (except
# ROLE) must be present on all 3 hosts. Never edit it after the SHA
# gate has passed without restarting every daemon.
#
# Topology: pod/host A = Spark master + driver (spark-submit client).
#           pod/host B = worker 1.  pod/host C = worker 2.
# =====================================================================

# --- Identity of THIS host: master | worker-b | worker-c --------------
ROLE=

# --- Public endpoints: the hostnames/IPs PEERS dial -------------------
# RunPod: the public IP shown in the pod's Connect panel.
# Generic hosts: the LAN IP / DNS name the other hosts use.
MASTER_PUBLIC_HOST=
WORKER_B_PUBLIC_HOST=
WORKER_C_PUBLIC_HOST=

# --- External (advertised) ports: what peers dial ---------------------
# RunPod: read these from the console's TCP port-mapping table AFTER
# deploy. Generic hosts (no NAT): set every EXT_* equal to its internal
# port below.
#
# HARD RULE (enforced by setup_multihost.sh): for the DRIVER port, the
# BLOCKMANAGER ports and the WORKER daemon ports, EXT must EQUAL the
# internal listen port (1:1 mapping). Spark advertises exactly the port
# it binds for these services; a NAT-shifted mapping cannot be bridged
# by configuration. If RunPod assigns a shifted mapping for one of
# these, redeploy that pod (assignment varies by host machine); if it
# still is not 1:1, STOP and report the platform block — see the
# failure-diagnosis section of OPERATOR_RUNBOOK.md. The MASTER RPC port
# is exempt: workers are handed the master URL explicitly, so
# EXT_MASTER_PORT may differ from MASTER_PORT.
EXT_MASTER_PORT=7077
EXT_DRIVER_PORT=41000
EXT_BLOCKMANAGER_PORT_B=42000
EXT_BLOCKMANAGER_PORT_C=42000
EXT_WORKER_PORT_B=7177
EXT_WORKER_PORT_C=7177
EXT_MASTER_WEBUI_PORT=8080
EXT_WORKER_WEBUI_B=8081
EXT_WORKER_WEBUI_C=8081

# --- Internal listen ports (fixed; services bind these) ---------------
MASTER_PORT=7077
MASTER_WEBUI_PORT=8080
WORKER_PORT=7177
WORKER_WEBUI_PORT=8081
DRIVER_PORT=41000
BLOCKMANAGER_PORT=42000

# --- Honest topology label (copied into the ground-truth JSON) --------
# RunPod:  use the first line. Generic hosts: use the second.
BAS_LABEL="Spark standalone cluster across 3 hosts (1 master/driver + 2 workers), RunPod EU-RO-1"
#BAS_LABEL="Spark standalone cluster across 3 hosts (1 master/driver + 2 workers)"

# --- Paths -------------------------------------------------------------
# RunPod: the shared research-ops volume. Generic hosts: a path that is
# a shared mount OR the same local path on every host (see
# HOSTS_RUNBOOK.md dataset-placement section).
MH_ROOT=/workspace/blind-multihost
# Package directory (this folder) on each host:
MH_PKG=/workspace/blind-multihost/pkg

# --- Versions and sizing ------------------------------------------------
SPARK_VERSION=3.5.3
WORKER_CORES=4
WORKER_MEMORY=6g
DRIVER_MEMORY=2g

# --- Interpreter ---------------------------------------------------------
# Leave empty: setup_multihost.sh auto-detects the volume venv
# (/workspace/.venv-pod/bin/python) and REFUSES interpreters < 3.12 or
# numpy != 2.5.4. NEVER point this at a pod's system python3 (3.10 on
# the RunPod base image — its multinomial draws differ and the SHA-256
# counts gate will fail; that failure is the gate working).
PY=
